[Unit]
Description=Elevate Life production web server
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/workspace/elevate-life
Environment=NODE_ENV=production
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStartPre=/usr/bin/test -f .next/BUILD_ID
ExecStart=%h/.local/bin/node %h/workspace/elevate-life/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
SyslogIdentifier=elevate-life

[Install]
WantedBy=default.target
