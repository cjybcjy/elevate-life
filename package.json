{
  "name": "elevate-life",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "store:preflight": "npx tsx scripts/store-preflight.ts",
    "store:preflight:check": "npx tsx scripts/check-store-preflight-readiness.ts",
    "store:submission": "npx tsx scripts/generate-store-submission-package.ts",
    "store:submission:check": "npx tsx scripts/check-store-submission-package-readiness.ts",
    "android:signing:check": "npx tsx scripts/validate-android-signing.ts",
    "android:aab:signature:check": "npx tsx scripts/validate-android-release-bundle-signature.ts",
    "android:apk:signature:check": "npx tsx scripts/validate-android-release-apk-signature.ts",
    "android:artifact:check": "npx tsx scripts/validate-capacitor-android-artifact.ts",
    "mobile:check": "npx tsx scripts/check-mobile-wrapper-readiness.ts",
    "mobile:identity:check": "npx tsx scripts/check-native-package-identity-readiness.ts",
    "mobile:sync": "npm run mobile:check && npx cap sync && npm run mobile:identity:check",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "mobile:permissions:check": "npx tsx scripts/validate-mobile-permissions.ts",
    "ios:archive:check": "npx tsx scripts/validate-ios-archive.ts",
    "twa:check": "npx tsx scripts/check-google-play-twa-readiness.ts",
    "twa:init": "npm run twa:check && npx tsx scripts/require-twa-env.ts && bubblewrap init --manifest=\"$TWA_MANIFEST_URL\" --directory=\"${TWA_OUTPUT_DIR:-android-twa}\"",
    "twa:update": "npm run twa:check && npx tsx scripts/require-twa-env.ts && cd \"${TWA_OUTPUT_DIR:-android-twa}\" && bubblewrap update",
    "twa:build": "npm run twa:check && npx tsx scripts/require-twa-env.ts && cd \"${TWA_OUTPUT_DIR:-android-twa}\" && bubblewrap build",
    "twa:artifact:check": "npx tsx scripts/validate-twa-build-artifact.ts",
    "privacy:check": "npx tsx scripts/check-market-privacy-readiness.ts",
    "release:env:template:check": "npx tsx scripts/check-store-release-env-template-readiness.ts",
    "release:check": "npx tsx scripts/validate-release-env.ts",
    "release:smoke": "npx tsx scripts/smoke-test-store-deployment.ts",
    "review:check": "npx tsx scripts/check-review-account-readiness.ts",
    "review:seed": "npx tsx prisma/seed.ts",
    "screenshots:check": "npx tsx scripts/check-store-screenshot-readiness.ts",
    "screenshots:store": "npx tsx scripts/capture-store-screenshots.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.6",
    "@capacitor/core": "^7.6.6",
    "@capacitor/ios": "^7.6.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@capacitor/cli": "^7.6.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
