# Backend
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ledger
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ENCRYPTION_THRESHOLD=500000
JWT_SECRET=your-jwt-secret-key-here
AUTH_SECRET=replace-with-at-least-32-random-bytes
# Backward-compatible alias; set only one of AUTH_SECRET or NEXTAUTH_SECRET.
# NEXTAUTH_SECRET=
AUTH_URL=http://localhost:3000
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CRON_SECRET=replace-with-at-least-32-random-bytes
# Defaults to closed when omitted. Supported: closed, invite, open.
REGISTRATION_MODE=closed
# Required only when REGISTRATION_MODE=invite; use at least 16 random characters.
REGISTRATION_INVITE_CODE=
# Optional comma-separated HTTPS hostnames for custom OpenAI-compatible providers.
AI_ALLOWED_ENDPOINT_HOSTS=
# Optional: gold/stock now use free public APIs (Sina/Tencent/Eastmoney)
# Only set these if you want to override with a custom paid API
# GOLD_API_URL=
# GOLD_API_KEY=
GOLD_EXCHANGE_RATE=7.2
# STOCK_API_URL=
# STOCK_API_KEY=
THROTTLE_LIMIT=100

# Frontend
VITE_API_URL=/api

# Store release identity
APP_PUBLIC_BASE_URL=https://app.example.com
APP_SUPPORT_EMAIL=support@example.com
STORE_SUBMISSION_OUTPUT_DIR=store-submission

# Native mobile wrapper
# Use a real HTTPS production URL before running Capacitor sync/build.
CAPACITOR_SERVER_URL=$APP_PUBLIC_BASE_URL
# Use a stable reverse-domain package id before the first store release.
CAPACITOR_APP_ID=com.elevatelife.app
ANDROID_NATIVE_PROJECT_DIR=android
IOS_NATIVE_PROJECT_DIR=ios
IOS_ARCHIVE_PATH=ios/build/ElevateLife.xcarchive
IOS_ARCHIVE_APP_NAME=App.app
# Optional comma-separated native permission allowlists.
MOBILE_ALLOWED_ANDROID_PERMISSIONS=
MOBILE_ALLOWED_IOS_USAGE_KEYS=

# Google Play TWA / Android App Links
ANDROID_PACKAGE_NAME=$CAPACITOR_APP_ID
# Comma-separated SHA-256 fingerprints from Play Console App Integrity or keytool.
ANDROID_SHA256_CERT_FINGERPRINTS=

# Google Play TWA / Bubblewrap packaging
TWA_MANIFEST_URL=$APP_PUBLIC_BASE_URL/manifest.webmanifest
TWA_OUTPUT_DIR=android-twa
TWA_SIGNING_KEY_PATH=/secure/path/elevate-life-upload.keystore
TWA_SIGNING_KEY_ALIAS=elevate-life
ANDROID_KEYSTORE_STORE_PASSWORD=
ANDROID_KEYSTORE_KEY_PASSWORD=

# Store screenshots
STORE_SCREENSHOT_BASE_URL=$APP_PUBLIC_BASE_URL
STORE_SCREENSHOT_OUTPUT_DIR=store-screenshots
# Review/demo account used to capture authenticated pages.
STORE_SCREENSHOT_USERNAME=demo
STORE_SCREENSHOT_PASSWORD=demo123

# Store review/demo account seeded by npm run review:seed.
REVIEW_ACCOUNT_USERNAME=demo
REVIEW_ACCOUNT_PASSWORD=demo123
