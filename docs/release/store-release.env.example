# Store release environment handoff
#
# Copy this checklist into your local release shell, CI secret manager, or a private
# .env.production.local file. Do not commit the filled values. Keystore passwords,
# review-account passwords, and production URLs are release secrets.
# 不要提交填好后的文件；这里需要真实 HTTPS 域名、真实支持邮箱和正式签名指纹。

# Public production origin. Must be a real HTTPS origin, with no path.
# 真实 HTTPS origin，不能使用 localhost 或 example.com。
APP_PUBLIC_BASE_URL=https://<your-production-host>

# Store review and public support contact.
APP_SUPPORT_EMAIL=support@<your-domain>

# Capacitor Android/iOS wrapper. CAPACITOR_SERVER_URL must equal APP_PUBLIC_BASE_URL.
CAPACITOR_SERVER_URL=https://<your-production-host>
CAPACITOR_APP_ID=com.elevatelife.app
ANDROID_PACKAGE_NAME=com.elevatelife.app
ANDROID_NATIVE_PROJECT_DIR=android
IOS_NATIVE_PROJECT_DIR=ios

# Google Play TWA / public URL checks.
TWA_MANIFEST_URL=https://<your-production-host>/manifest.webmanifest
STORE_SCREENSHOT_BASE_URL=https://<your-production-host>

# Android signing. Keep upload keystore and passwords outside git.
TWA_SIGNING_KEY_PATH=/secure/path/elevate-life-upload.jks
TWA_SIGNING_KEY_ALIAS=elevate-life
ANDROID_KEYSTORE_STORE_PASSWORD=
ANDROID_KEYSTORE_KEY_PASSWORD=

# Include upload keystore SHA-256 and, after Play Console enables it,
# the Play App Signing SHA-256. Multiple fingerprints are comma-separated.
ANDROID_SHA256_CERT_FINGERPRINTS=

# Build artifacts used by release validators.
ANDROID_RELEASE_BUNDLE_PATH=android/app/build/outputs/bundle/release/app-release.aab
ANDROID_RELEASE_APK_PATH=android/app/build/outputs/apk/release/app-release.apk
# Optional override when apksigner is not on PATH and ANDROID_HOME / ANDROID_SDK_ROOT are unset.
ANDROID_APKSIGNER_PATH=
IOS_ARCHIVE_PATH=ios/build/ElevateLife.xcarchive
IOS_ARCHIVE_APP_NAME=App.app

# Store screenshot and review/demo account.
STORE_SCREENSHOT_OUTPUT_DIR=store-screenshots
STORE_SCREENSHOT_USERNAME=demo
STORE_SCREENSHOT_PASSWORD=
REVIEW_ACCOUNT_USERNAME=demo
REVIEW_ACCOUNT_PASSWORD=

# Optional comma-separated native permission allowlists.
MOBILE_ALLOWED_ANDROID_PERMISSIONS=
MOBILE_ALLOWED_IOS_USAGE_KEYS=
